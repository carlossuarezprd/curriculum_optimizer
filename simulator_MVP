// flagship set (from Sergio's screenshot) by course id
const FLAGSHIPS=new Set(['35201','34101','42121','37202','38119','34106','38120','33401','33471','33305','35120','30131','38103','34702','31401']);
C.forEach(c=>{ if(FLAGSHIPS.has(c.id)) c.flag=true; });

const CORE_AREAS=['Accounting','Micro','Stats','Finance','Marketing','Operations','Strategy','Decisions','People','Economy','Society'];
const CONCS=[{k:'AF',n:'Analytic Finance',need:6},{k:'AI',n:'Applied AI',need:3},{k:'EN',n:'Entrepreneurship',need:3}];
const QS=[{id:'y1a',l:'Y1 · Autumn',t:'A'},{id:'y1w',l:'Y1 · Winter',t:'W'},{id:'y1s',l:'Y1 · Spring',t:'S'},
          {id:'y2a',l:'Y2 · Autumn',t:'A'},{id:'y2w',l:'Y2 · Winter',t:'W'},{id:'y2s',l:'Y2 · Spring',t:'S'}];

let place={}; C.forEach(c=>place[c.id]='list');
let activeFilters=new Set(); let dragId=null;
const toast=document.getElementById('toast');let tt;
function showToast(m){toast.textContent=m;toast.classList.add('show');clearTimeout(tt);tt=setTimeout(()=>toast.classList.remove('show'),2200);}

// filters
const FILTER_DEFS=[...CORE_AREAS.map(a=>({key:a,label:a})),{key:'__ELEC__',label:'Electives',elec:true}];
function buildFilters(){
  const f=document.getElementById('filters');f.innerHTML='';
  FILTER_DEFS.forEach(fd=>{
    const b=document.createElement('span');b.className='fbtn'+(fd.elec?' elec':'');b.textContent=fd.label;
    b.onclick=()=>{ if(activeFilters.has(fd.key))activeFilters.delete(fd.key); else activeFilters.add(fd.key); b.classList.toggle('on'); renderList(); };
    f.appendChild(b);
  });
}
function courseVisible(c){
  if(activeFilters.size===0) return true;
  for(const f of activeFilters){
    if(f==='__ELEC__'){ if(c.core===null) return true; }
    else if(c.core===f) return true;
  }
  return false;
}
function termStr(t){return t.split('').join('/');}
function renderList(){
  const wrap=document.getElementById('courselist');wrap.innerHTML='';
  C.filter(courseVisible).forEach(c=>{
    const el=document.createElement('div');
    el.className='course '+c.area+(place[c.id]!=='list'?' placed':'')+(c.flag?' flagship':'');
    el.draggable=true;el.dataset.cid=c.id;
    el.innerHTML=`<div class="nm">${c.nm}</div><div class="meta">${c.id} · ${termStr(c.terms)}${c.core?' · '+c.core:' · elective'}</div>
      <div class="ic">${c.flag?'<span class="fl">★</span>':''}${c.pq?'<span class="pq" data-pq="'+c.id+'">⬡</span>':''}</div>`;
    el.addEventListener('dragstart',e=>{dragId=c.id;el.classList.add('dragging');e.dataTransfer.setData('text/plain',c.id);e.dataTransfer.effectAllowed='move';});
    el.addEventListener('dragend',()=>{dragId=null;el.classList.remove('dragging');clearHl();});
    wrap.appendChild(el);
  });
  wrap.querySelectorAll('.pq').forEach(p=>p.addEventListener('click',e=>{e.stopPropagation();openModal(p.dataset.pq);}));
}
function clearHl(){document.querySelectorAll('.q').forEach(q=>q.classList.remove('dragover','valid','invalid'));}

function buildBoard(){
  const b=document.getElementById('board');b.innerHTML='';
  QS.forEach(q=>{
    const card=document.createElement('div');card.className='q';card.id='q-'+q.id;
    card.innerHTML=`<h3>${q.l}<span class="cnt" id="cnt-${q.id}"></span></h3><div class="drop" id="drop-${q.id}"></div>`;
    b.appendChild(card);
    card.addEventListener('dragover',e=>{e.preventDefault();if(!dragId)return;const c=C.find(x=>x.id===dragId);const ok=c.terms.includes(q.t);card.classList.add('dragover');card.classList.toggle('valid',ok);card.classList.toggle('invalid',!ok);e.dataTransfer.dropEffect=ok?'move':'none';});
    card.addEventListener('dragleave',e=>{if(!card.contains(e.relatedTarget))card.classList.remove('dragover','valid','invalid');});
    card.addEventListener('drop',e=>{e.preventDefault();card.classList.remove('dragover','valid','invalid');const cid=e.dataTransfer.getData('text/plain');const c=C.find(x=>x.id===cid);if(!c)return;if(!c.terms.includes(q.t)){showToast(`${c.nm.split('(')[0].trim()} isn't offered in ${q.t==='A'?'Autumn':q.t==='W'?'Winter':'Spring'} (only ${termStr(c.terms)})`);return;}place[cid]=q.id;render();});
  });
  const side=document.querySelector('.side');
  side.addEventListener('dragover',e=>{e.preventDefault();e.dataTransfer.dropEffect='move';});
  side.addEventListener('drop',e=>{e.preventDefault();const cid=e.dataTransfer.getData('text/plain');if(cid){place[cid]='list';render();}});
}
function pcEl(c){
  const el=document.createElement('div');el.className='pc '+c.area;el.draggable=true;el.dataset.cid=c.id;
  el.innerHTML=`<span>${c.nm.split('(')[0].trim()}</span><span class="pcic">${c.flag?'<span class="fl">★</span>':''}${c.pq?'<span class="pq" data-pq="'+c.id+'">⬡</span>':''}</span>`;
  el.addEventListener('dragstart',e=>{dragId=c.id;e.dataTransfer.setData('text/plain',c.id);e.dataTransfer.effectAllowed='move';});
  el.addEventListener('dragend',()=>{dragId=null;clearHl();});
  el.querySelectorAll('.pq').forEach(p=>p.addEventListener('click',ev=>{ev.stopPropagation();openModal(p.dataset.pq);}));
  return el;
}
function render(){
  QS.forEach(q=>document.getElementById('drop-'+q.id).innerHTML='');
  const per={};QS.forEach(q=>per[q.id]=[]);
  C.forEach(c=>{if(place[c.id]!=='list')per[place[c.id]].push(c);});
  QS.forEach(q=>{const d=document.getElementById('drop-'+q.id);per[q.id].forEach(c=>d.appendChild(pcEl(c)));document.getElementById('cnt-'+q.id).textContent=per[q.id].length;});
  renderList();
  // core areas
  const placed=C.filter(c=>place[c.id]!=='list');
  const covered=new Set(placed.filter(c=>c.core).map(c=>c.core));
  const cc=document.getElementById('coreChecks');cc.innerHTML='';
  CORE_AREAS.forEach(a=>{const met=covered.has(a);const d=document.createElement('div');d.className='ri'+(met?' met':'');d.innerHTML=`<span class="dot"></span>${a}`;cc.appendChild(d);});
  const n=covered.size;
  const cs=document.getElementById('coreSummary');
  const enough=n>=10;
  cs.className='summary '+(enough?'ok':'no');
  cs.textContent=`${n}/11 areas covered — ${enough?'10-of-11 rule met ✓':'need '+(10-n)+' more'}`;
  // concentrations
  const conc=document.getElementById('concChecks');conc.innerHTML='';
  CONCS.forEach(co=>{const list=placed.filter(c=>c.conc.includes(co.k));const cnt=list.length;const met=cnt>=co.need;
    const div=document.createElement('div');div.className='conc'+(met?' met':'');
    div.innerHTML=`<div class="t"><span>${co.n}</span><span class="s">${cnt}/${co.need} ${met?'✓':''}</span></div><div class="concbar"><div class="f" style="width:${Math.min(100,cnt/co.need*100)}%"></div></div>`;
    conc.appendChild(div);});
  // flagships
  const fl=placed.filter(c=>c.flag);
  document.getElementById('flagN').textContent=fl.length;
  document.getElementById('flagList').textContent=fl.map(c=>c.nm.split('(')[0].trim()).join(', ')||'none placed yet';
}
function openModal(cid){
  const c=C.find(x=>x.id===cid);if(!c)return;
  document.getElementById('mTitle').textContent=c.nm.split('(')[0].trim();
  document.getElementById('mCode').textContent=c.id+' · offered '+termStr(c.terms);
  document.getElementById('mBody').innerHTML=`<span class="lab">Prerequisites:</span><br>${c.pq||'None'}`;
  document.getElementById('modal').classList.add('show');
}
document.getElementById('modalX').onclick=()=>document.getElementById('modal').classList.remove('show');
document.getElementById('modal').onclick=e=>{if(e.target.id==='modal')document.getElementById('modal').classList.remove('show');};
document.getElementById('clear').onclick=()=>{C.forEach(c=>place[c.id]='list');render();};

buildFilters();buildBoard();render();
</script>
